{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Cursor Subagent Toggle",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ]
    }
  ]
}

{
  "name": "cursor-subagent-toggle",
  "displayName": "Cursor Subagent Toggle",
  "description": "Toggle Cursor subagent hooks globally and per workspace folder, with status bar feedback for single-folder and multi-root workspaces.",
  "version": "0.1.2",
  "publisher": "taehyunkim3",
  "icon": "media/marketplace-icon.png",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/taehyunkim3/cursor-subagent-toggle.git"
  },
  "bugs": {
    "url": "https://github.com/taehyunkim3/cursor-subagent-toggle/issues"
  },
  "homepage": "https://github.com/taehyunkim3/cursor-subagent-toggle#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "keywords": [
    "cursor",
    "subagent",
    "hooks",
    "workspace",
    "toggle"
  ],
  "categories": [
    "Other"
  ],
  "files": [
    "out/**",
    "media/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:cursorSubagentToggle.sidebar",
    "onCommand:cursorSubagentToggle.showActions",
    "onCommand:cursorSubagentToggle.toggleGlobal",
    "onCommand:cursorSubagentToggle.toggleCurrentWorkspaceFolder",
    "onCommand:cursorSubagentToggle.toggleWorkspaceFolder",
    "onCommand:cursorSubagentToggle.applyRecommendedGlobal",
    "onCommand:cursorSubagentToggle.applyRecommendedCurrentWorkspaceFolder",
    "onCommand:cursorSubagentToggle.applyRecommendedWorkspaceFolder",
    "onCommand:cursorSubagentToggle.refresh"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "build": "tsc -p .",
    "vscode:prepublish": "npm run build",
    "package:vsix": "vsce package",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.7.1",
    "ovsx": "^0.10.10",
    "typescript": "^5.8.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "cursorSubagentToggle.showActions",
        "title": "Cursor Subagent Toggle: Open Controls"
      },
      {
        "command": "cursorSubagentToggle.toggleGlobal",
        "title": "Cursor Subagent Toggle: Toggle Global Blocker"
      },
      {
        "command": "cursorSubagentToggle.toggleCurrentWorkspaceFolder",
        "title": "Cursor Subagent Toggle: Toggle Current Workspace Folder Blocker"
      },
      {
        "command": "cursorSubagentToggle.toggleWorkspaceFolder",
        "title": "Cursor Subagent Toggle: Toggle Workspace Folder Blocker"
      },
      {
        "command": "cursorSubagentToggle.applyRecommendedGlobal",
        "title": "Cursor Subagent Toggle: Apply Recommended Global Config"
      },
      {
        "command": "cursorSubagentToggle.applyRecommendedCurrentWorkspaceFolder",
        "title": "Cursor Subagent Toggle: Apply Recommended Config For Current Workspace Folder"
      },
      {
        "command": "cursorSubagentToggle.applyRecommendedWorkspaceFolder",
        "title": "Cursor Subagent Toggle: Apply Recommended Config For Workspace Folder"
      },
      {
        "command": "cursorSubagentToggle.refresh",
        "title": "Cursor Subagent Toggle: Refresh Status"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursorSubagentToggle",
          "title": "Subagent",
          "icon": "media/subagent.svg"
        }
      ]
    },
    "views": {
      "cursorSubagentToggle": [
        {
          "id": "cursorSubagentToggle.sidebar",
          "name": "Subagent Status",
          "type": "webview"
        }
      ]
    },
    "menus": {}
  }
}
